# ==============================================================================
# Environment Variables สำหรับระบบห้องสมุดหมวดภาษาไทย โรงเรียนบรรหารแจ่มใสวิทยา ๓
# คัดลอกไฟล์นี้เป็น .env.local แล้วระบุค่าจริง
# หรือนำค่าเหล่านี้ไปเพิ่มใน Environment Variables บน Vercel Dashboard
# ==============================================================================

# Supabase Configuration
# รับค่าได้จากหน้า Project Settings -> API บน https://supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client-side Supabase (Optional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Sheets Webhook URL (Optional)
# ได้จากการ Deploy Google Apps Script เป็น Web App
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
